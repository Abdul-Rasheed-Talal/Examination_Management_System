# CIT Department Academic & Result Management System
# Apache, cPanel & CWP Web Server Configuration

# Disable Directory Browsing for Security
Options -Indexes

# Default Charset
AddDefaultCharset UTF-8

# Protect sensitive database configuration, internal classes, and schema files
<FilesMatch "^(db_config\.php|db\.php|schema\.sql|\.git|\.gitignore)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent Browser Caching of JSON files and API endpoints so teachers and admin always see live cloud data
<IfModule mod_headers.c>
    <FilesMatch "\.(json|php)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, post-check=0, pre-check=0"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>

    # Allow cross-device AJAX access
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Cache-Control, Pragma, X-Requested-With"
</IfModule>

# Set correct MIME type for JSON
<IfModule mod_mime.c>
    AddType application/json .json
</IfModule>

# Ensure index.html loads by default
DirectoryIndex index.html index.php
